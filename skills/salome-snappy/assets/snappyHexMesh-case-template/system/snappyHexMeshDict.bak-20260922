/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh false;
snap            false;
addLayers       true;

geometry
{
    "BASENAME_surface.stl"
    {
        type triSurfaceMesh;
        name BASENAME_surface;
    }
}

castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 100000000;
    minRefinementCells 0;
    nCellsBetweenLevels 3;

    features
    (
    );

    refinementSurfaces
    {
        BASENAME_surface
        {
            patchInfo
            {
                type patch;
            }
            addBufferLayers false;
            level (6 9);
        }
    }

    resolveFeatureAngle 30;
    refinementRegions {}
    locationInMesh (0 0 0);

    allowFreeStandingZoneFaces yes;
}

snapControls
{
    nSmoothPatch 5;
    tolerance 1.0;
    nSolveIter 300;
    nRelaxIter 10;
    nFeatureSnapIter 10;

    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap no;
    concaveAngle 45;
    minAreaRatio 0.3;
}

addLayersControls
{
    relativeSizes false;
    thicknessModel firstAndExpansion;
    layers
    {
        "BASENAME_surface"
        {
            nSurfaceLayers BASE_LAYERS;
        }
    }
    expansionRatio BASE_GROWTH;
    firstLayerThickness BASE_FIRSTLAYER;
    thickness BASE_TOTALTHICKNESS;
    minThickness BASE_MINTHICKNESS;
    nGrow 0;

    minMedialAxisAngle 90;
    maxThicknessToMedialRatio 0.3;

    featureAngle 150;
    nRelaxIter 3;
    nSmoothSurfaceNormals 25;
    nSmoothNormals 20;
    nMedialAxisIter 20;
    nSmoothThickness 15;
    maxFaceThicknessRatio 0.5;
    nBufferCellsNoExtrude 2;
    nLayerIter 50;
    nRelaxedIter 20;
}

meshQualityControls
{
    maxNonOrtho         75;
    maxBoundarySkewness 30;
    maxInternalSkewness 10;
    maxConcave          80;
    minVol              1e-13;
    minDeterminant      0.001;
    minArea             -1;
    minTwist            0.02;
    minTriangleTwist    -1;
    minFaceWeight       0.05;
    minVolRatio         0.05;

    minTetQuality       1e-15;
    minFlatness         0.5;
    minFacePyramidVolume 1e-20;

    relaxed
    {
        maxNonOrtho     75;
    }

    nSmoothScale 15;
    errorReduction 0.75;
}

mergeTolerance 1e-6;
