/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh false;
snap            false;
addLayers       true;

geometry
{
    "BASENAME_surface.stl"
    {
        type triSurfaceMesh;
        name BASENAME_surface;
    }
}

castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 100000000;
    minRefinementCells 0;
    nCellsBetweenLevels 5;   // 급격한 배경 격자 해상도 변화로 인한 Layer Collapse 방지

    features
    (
    );

    refinementSurfaces
    {
        BASENAME_surface
        {
            patchInfo
            {
                type patch;
            }
            addBufferLayers false;
            level (6 9);
        }
    }

    resolveFeatureAngle 30;
    refinementRegions {}
    locationInMesh (0 0 0);

    allowFreeStandingZoneFaces yes;
}

snapControls
{
    nSmoothPatch 5;
    tolerance 1.0;
    nSolveIter 300;
    nRelaxIter 10;
    nFeatureSnapIter 10;

    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap no;
    concaveAngle 45;
    minAreaRatio 0.3;
}

addLayersControls
{
    relativeSizes false;
    thicknessModel firstAndRelativeFinal;
    layers
    {
        "BASENAME_surface"
        {
            nSurfaceLayers BASE_NLAYERS;
        }
    }
    firstLayerThickness BASE_FIRSTLAYER;
    finalLayerThickness 0.5;
    minThickness  1e-6;
    nGrow  0;

    minMedialAxisAngle 90;
    maxThicknessToMedialRatio 100.0; // 5.0 -> 100.0 (LE/곡면 국소 미세 셀 영역 두께 제약 해제)
    maxFaceThicknessRatio 1000.0;    // 100.0 -> 1000.0 (배경 격자 크기 대비 두께 제약 대폭 완화)
    minFaceWeight -1;
    minVolRatio -1;

    // [버퍼 셀 제거 - 실패 지점 인접 셀까지 동반 삭제되는 현상 방지]
    nBufferCellsNoExtrude 0;         // 3 -> 0

    // [스무딩 및 완화 횟수 증가]
    featureAngle 180;                // 75 -> 180
    nRelaxIter 50;                   // 10 -> 50
    nSmoothSurfaceNormals 5;         // 1 -> 5 (LE 곡면의 법선 스무딩 강화)
    nSmoothThickness 20;             // 10 -> 20
    nSmoothNormals 5;                // 3 -> 5
    nMedialAxisIter 50;              // 20 -> 50
    nLayerIter 200;                  // 50 -> 200
    nRelaxedIter 50;                 // 20 -> 50

    // [Extrusion 단계 품질 기준 완화]
    relaxed
    {
        maxNonOrtho     95;          // 90 -> 95
        minFaceWeight   0.0001;      // 0.005 -> 0.0001
        minVolRatio     0.0001;      // 0.005 -> 0.0001
    }
}

meshQualityControls
{
    maxNonOrtho         85;          // 80 -> 85
    maxBoundarySkewness 20;
    maxInternalSkewness 20;          // [핵심] 4 -> 20 (Refinement 경계 셀의 왜곡 허용)
    maxConcave          80;
    minVol              1e-15;       // 1e-13 -> 1e-15
    minDeterminant      1e-5;        // 0.001 -> 1e-5
    minArea             -1;
    minTwist            -1;          // 0.02 -> -1
    minTriangleTwist    -1;
    minFaceWeight       0.0001;      // [핵심] 0.05 -> 0.0001
    minVolRatio         0.0001;      // [핵심] 0.01 -> 0.0001

    minTetQuality       1e-15;       // 1e-9 -> 1e-15
    minFlatness         0.5;
    minFacePyramidVolume 1e-20;

    relaxed
    {
        maxNonOrtho     95;          // 85 -> 95
    }

    nSmoothScale 15;
    errorReduction 0.75;
}

mergeTolerance 1e-6;
