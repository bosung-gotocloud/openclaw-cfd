FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform @omegaIni@;

boundaryField
{
    far
    {
        type            freestream;
        freestreamValue uniform @omegaIni@;
        value           uniform @omegaIni@;
    }

    @surfaceName@
    {
        type            omegaWallFunction;
        value           uniform 1e8;
    }
}

