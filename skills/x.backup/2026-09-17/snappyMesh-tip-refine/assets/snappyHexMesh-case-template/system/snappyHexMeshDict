FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh yes;
snap            yes;
addLayers       yes;

geometry
{
    "STL_SURFACE.stl"
    {
        type triSurfaceMesh;
        name STL_SURFACE;
    }
    REFINEBOX_NAME
    {
        type searchableBox;
        min REFINEBOX_MIN;
        max REFINEBOX_MAX;
    }
    // TIP_WAKE_LINE_PLACEHOLDER
}

castellatedMeshControls
{
    maxLocalCells  BASE_MAXLOCAL;
    maxGlobalCells  BASE_MAXGLOBAL;
    minRefinementCells 0;
    maxLoadUnbalance 0.5;
    nCellsBetweenLevels 3;
    features
    ();
    refinementSurfaces
    {
        STL_SURFACE
        {
            patchInfo
            {
                type wall;
            }
            level SURFACE_LEVEL;
        }
    }
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces yes;
    locationInMesh LOCATION_IN_MESH;
    refinementRegions
    {
        // TIP_WAKE_LINE_REF_PLACEHOLDER
        REFINEBOX_NAME
        {
            mode REFINEBOX_MODE;
            levels ((1 LEVEL));
        }
    }
}

snapControls
{
    nSmoothPatch  0;
    nSmoothInternal 0;
    tolerance  3;
    nSolveIter  30;
    nRelaxIter  30;
    nFeatureSnapIter 15;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap no;
    concaveAngle 45;
    minAreaRatio 0.3;
}

addLayersControls
{
    relativeSizes false;
    thicknessModel firstAndExpansion;
    layers
    {
        "STL_SURFACE"
        {
            nSurfaceLayers BASE_LAYERS;
        }
    }
    firstLayerThickness BASE_FIRSTLAYER;
    nLayers  BASE_NLAYERS;
    expansionRatio  BASE_EXPANSION_RATIO;
    minThickness  1e-6;
    nGrow  0;

    minMedialAxisAngle 90;
    maxThicknessToMedialRatio 5.0;

    featureAngle 75;
    nRelaxIter 10;
    nSmoothSurfaceNormals 1;
    nSmoothThickness 10;
    maxFaceThicknessRatio 5.0;
    nSmoothNormals 3;
    nMedialAxisIter 20;
    maxThicknessToMedialRatio 5;
    minFaceWeight -1;
    minVolRatio -1;
    nBufferCellsNoExtrude 3;
    nLayerIter 50;
    nRelaxedIter 20;

    relaxed
    {
        maxNonOrtho     85;
        minFaceWeight   0.005;
        minVolRatio     0.005;
    }
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minDeterminant      0.001;
    minArea             -1;
    minTwist            0.02;
    minTriangleTwist    -1;
    minFaceWeight       0.05;
    minVolRatio         0.01;

    minTetQuality       1e-9;
    minFlatness         0.5;
    minFacePyramidVolume 1e-20;

    relaxed
    {
        maxNonOrtho     75;
    }

    nSmoothScale 15;
    errorReduction 0.75;
}

mergeTolerance 1e-6;
