FoamFile
{
 version 2.0;
 format ascii;
 class volScalarField;
 location 0;
 object p;
}

#include        "include/freestreamConditions"

dimensions      [1 -1 -2 0 0 0 0]; 

internalField   uniform @pInf@;

boundaryField
{
  far
  {
        type            characteristicFarfieldPressure;
        #include        "include/freestreamConditions";
        value           $internalField;
  }
  @surfaceName@
  {
        type            characteristicWallPressure;
        value           $internalField;
  }
}
