forceCoeffs1
{
    type            forceCoeffs;

    libs            (forces);

    writeControl    timeStep;
    writeInterval   1;

    log             yes;

    patches         (surface);
    rho             rhoInf;      // Indicates incompressible
    rhoInf          1.225;           // Required when rho = rhoInf
    liftDir         (0 0 1);
    dragDir         (1 0 0);
    CofR            (0.0 0.0 0.0);  // Pitch point
    pitchAxis       (0 1 0);
    magUInf         41.667;
    lRef            1.0;
    Aref            1.0;
}

// Raw forces and moments (Fx, Fy, Fz, Mx, My, Mz) on surface patch
forces1
{
    type            forces;

    libs            (forces);

    writeControl    timeStep;
    writeInterval   1;

    log             yes;

    patches         (surface);
    rho             rhoInf;
    rhoInf          1.225;
    CofR            (0.0 0.0 0.0);
    liftDir         (0 0 1);
    dragDir         (1 0 0);
    pitchAxis       (0 1 0);
}


