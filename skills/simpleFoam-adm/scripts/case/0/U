FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (41.667 0.0 0.0);

boundaryField
{
    far
    {
        type            freestreamVelocity;
        freestreamValue uniform (41.667 0.0 0.0);
        value           uniform (41.667 0.0 0.0);
    }

    surface
    {
        type            noSlip;
        value           uniform (0 0 0);
    }
}

