FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}

actuatorDisk
{
    type            actuationDiskSource;
    active          on;

    // Selection
    selectionMode     cellZone;
    cellZone          actuatorDiskZone;

    // Actuator disk geometric properties
    diskArea        1.477559009048303;
    diskDir         (1.0 0.0 0.0);
    diskCentre      (0.0 0.0 0.0);

    // Force method
    variant         Froude;

    // Monitor method
    monitorMethod   points;
    upstreamPoint   (0.0 0.0 0.0);

    // Thrust and power coefficients
    Ct              constant -0.0001;
    Cp              constant 0.0088;

    sink            false;
}
