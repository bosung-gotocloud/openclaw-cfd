FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     snappyHexMesh;

startTime         0;
stopAt            endTime;
endTime           1;
deltaT            1;

writeControl     none;
writeFormat       ascii;
writePrecision    6;
writeCompression  off;

timeStep          1;

adjustTimeStep    no;

writeFrequency    0;
