FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh yes;
snap            yes;
addLayers       yes;

geometry
{
    "STL_SURFACE.stl"
    {
        type triSurfaceMesh;
        name STL_SURFACE;
    }
    REFINEBOX_NAME
    {
        type searchableBox;
        min REFINEBOX_MIN;
        max REFINEBOX_MAX;
    }
    // TIP_WAKE_LINE_PLACEHOLDER
}

castellatedMeshControls
{
    maxLocalCells  BASE_MAXLOCAL;
    maxGlobalCells  BASE_MAXGLOBAL;
    minRefinementCells 0;
    maxLoadUnbalance 0.5;
    nCellsBetweenLevels 3;  // 급격한 배경 격자 해상도 변화로 인한 Layer Collapse 방지
    features
    ();
    refinementSurfaces
    {
        STL_SURFACE
        {
            patchInfo
            {
                type wall;
            }
            level SURFACE_LEVEL;
        }
    }
    resolveFeatureAngle 10;
    allowFreeStandingZoneFaces yes;
    locationInMesh LOCATION_IN_MESH;
    refinementRegions
    {
        // TIP_WAKE_LINE_REF_PLACEHOLDER
        REFINEBOX_NAME
        {
            mode REFINEBOX_MODE;
            levels ((1 LEVEL));
        }
    }
}

snapControls
{
    nSmoothPatch  0;
    nSmoothInternal 0;
    tolerance  3;
    nSolveIter  30;
    nRelaxIter  30;
    nFeatureSnapIter 15;
    implicitFeatureSnap false;
    explicitFeatureSnap false;
    multiRegionFeatureSnap no;
    concaveAngle 45;
    minAreaRatio 0.3;
}

addLayersControls
{
    relativeSizes false;
    thicknessModel firstAndExpansion;
    layers
    {
        "STL_SURFACE"
        {
            nSurfaceLayers BASE_LAYERS;
        }
    }
    firstLayerThickness BASE_FIRSTLAYER;
    nLayers  BASE_NLAYERS;
    expansionRatio  BASE_EXPANSION_RATIO;
    minThickness  1e-6;
    nGrow  0;

    minMedialAxisAngle 90;
    maxThicknessToMedialRatio 100.0;   // 15.0 -> 100.0 (국소 미세 셀 영역 두께 제약 해제)
    maxFaceThicknessRatio 1000.0;     // 300.0 -> 1000.0
    minFaceWeight -1;
    minVolRatio -1;

    nBufferCellsNoExtrude 0;          // 1 -> 0

    // [스무딩 및 완화 횟수 증가]

    featureAngle 180;                 // 120 -> 180 (LE edge snap 강화)
    nRelaxIter 50;                    // 10 -> 50
    nSmoothSurfaceNormals 5;          // 1 -> 5
    nSmoothThickness 20;              // 10 -> 20
    nSmoothNormals 5;                 // 3 -> 5
    nMedialAxisIter 50;               // 30 -> 50
    nLayerIter 200;                   // 100 -> 200
    nRelaxedIter 50;                  // 20 -> 50

    relaxed
    {
        maxNonOrtho     95;
        minFaceWeight   0.0001;       // 0.001 -> 0.0001
        minVolRatio     0.0001;       // 0.001 -> 0.0001
    }
}

meshQualityControls
{
    maxNonOrtho         85;           // 65 -> 85
    maxBoundarySkewness 20;
    maxInternalSkewness 20;           // 4 -> 20
    maxConcave          80;
    minVol              1e-15;        // 1e-13 -> 1e-15
    minDeterminant      1e-5;         // 0.001 -> 1e-5
    minArea             -1;
    minTwist            -1;           // 0.02 -> -1
    minTriangleTwist    -1;
    minFaceWeight       0.0001;       // 0.05 -> 0.0001
    minVolRatio         0.0001;       // 0.01 -> 0.0001

    minTetQuality       1e-15;        // 1e-9 -> 1e-15
    minFlatness         0.5;
    minFacePyramidVolume 1e-20;

    relaxed
    {
        maxNonOrtho     95;           // 75 -> 95
    }

    nSmoothScale 15;
    errorReduction 0.75;
}

mergeTolerance 1e-6;
