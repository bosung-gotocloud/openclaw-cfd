FoamFile
{
 version 2.0;
 format ascii;
 class volScalarField;
 location 0;
 object k;
}

dimensions [0 2 -2 0 0 0 0]; 

internalField uniform @kIni@ ; // = 3/2*(I*|U|)^2

boundaryField
{
  far
  {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       @intensity@; // turbulence intensity
        value           $internalField;
  }
  @surfaceName@
  {
        type            kqRWallFunction;
        value           uniform 1e-11;
  }
}
